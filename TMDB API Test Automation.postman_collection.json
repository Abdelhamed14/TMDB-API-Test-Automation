    {
      "name": "05 - Get Popular Movies",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const responseBody = pm.response.json();\r",
              "const movies = responseBody.results;\r",
              "\r",
              "pm.test(\"Status code is 200 OK\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Response contains 20 movies\", function () {\r",
              "    pm.expect(movies).to.be.an(\"array\");\r",
              "    pm.expect(movies.length).to.eql(20);\r",
              "});\r",
              "\r",
              "pm.test(\"Pagination fields are present\", function () {\r",
              "    pm.expect(responseBody).to.have.property(\"page\");\r",
              "    pm.expect(responseBody).to.have.property(\"total_pages\");\r",
              "    pm.expect(responseBody).to.have.property(\"total_results\");\r",
              "});\r",
              "\r",
              "pm.test(\"Each movie contains the required fields\", function () {\r",
              "    movies.forEach(function (movie) {\r",
              "        pm.expect(movie).to.have.property(\"id\");\r",
              "        pm.expect(movie).to.have.property(\"title\");\r",
              "        pm.expect(movie).to.have.property(\"vote_average\");\r",
              "        pm.expect(movie).to.have.property(\"popularity\");\r",
              "    });\r",
              "});\r",
              "\r",
              "pm.test(\"Movies are sorted by popularity in descending order\", function () {\r",
              "    const actualPopularity = movies.map(function (movie) {\r",
              "        return movie.popularity;\r",
              "    });\r",
              "\r",
              "    const sortedPopularity = [...actualPopularity].sort(function (a, b) {\r",
              "        return b - a;\r",
              "    });\r",
              "\r",
              "    pm.expect(actualPopularity).to.eql(sortedPopularity);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
