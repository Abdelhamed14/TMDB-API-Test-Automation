    {
      "name": "01 - Search Movies by Keyword",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const responseBody = pm.response.json();\r",
              "\r",
              "pm.test(\"Status code is 200 OK\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Response contains results array\", function () {\r",
              "    pm.expect(responseBody).to.have.property(\"results\");\r",
              "    pm.expect(responseBody.results).to.be.an(\"array\");\r",
              "});\r",
              "\r",
              "pm.test(\"Search returned at least one result\", function () {\r",
              "    pm.expect(responseBody.results.length).to.be.above(0);\r",
              "    pm.expect(responseBody.total_results).to.be.above(0);\r",
              "});\r",
              "\r",
              "pm.test(\"Movie titles are relevant to the search keyword\", function () {\r",
              "    const keyword = \"inception\";\r",
              "\r",
              "    const relevantMovieExists = responseBody.results.some(function (movie) {\r",
              "        return movie.title.toLowerCase().includes(keyword);\r",
              "    });\r",
              "\r",
              "    pm.expect(relevantMovieExists).to.be.true;\r",
              "});\r",
              "\r",
              "pm.test(\"Each movie contains the required fields\", function () {\r",
              "    responseBody.results.forEach(function (movie) {\r",
              "        pm.expect(movie).to.have.property(\"id\");\r",
              "        pm.expect(movie).to.have.property(\"title\");\r",
              "        pm.expect(movie).to.have.property(\"release_date\");\r",
              "        pm.expect(movie).to.have.property(\"overview\");\r",
              "    });\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
